# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "anon" / publishable key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / secret key — SERVER ONLY, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
# Your email: the first sign-in with it becomes the admin automatically
ADMIN_EMAIL=you@example.com
# Public URL of the deployment (used in invite links)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# Timezone for "day open" and daily candles
APP_TIMEZONE=Asia/Riyadh
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# ---- Price sources (server only; any can be left empty) ----
GOLDAPI_KEY=
API_NINJAS_KEY=
# Optional override of the API Ninjas endpoint
# API_NINJAS_URL=https://api.api-ninjas.com/v1/goldprice

# ---- Web Push (npx web-push generate-vapid-keys) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Telegram (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ---- Claude daily summary (optional) ----
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
